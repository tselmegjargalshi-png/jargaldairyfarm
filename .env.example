# Copy to .env.local for local development. NEVER commit real values.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=

# Admin panel (/admin). Choose a strong password and a random secret (24+ chars).
ADMIN_PASSWORD=
SESSION_SECRET=

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Vercel Blob read/write token — enables image/video upload from the admin panel
BLOB_READ_WRITE_TOKEN=
